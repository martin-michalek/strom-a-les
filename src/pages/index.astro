---
import { Image } from 'astro:assets';
import etw from '../assets/brand/etw.png';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import Gallery from '../components/Gallery.astro';
import Icon from '../components/Icon.astro';
import { CERTIFICATES, SITE, phoneHref, u } from '../config';
import { GALLERY, GALLERY_TEASER, PHOTOS } from '../data/images';
import { CATEGORIES, servicesIn, serviceHref } from '../data/services';
import { FAQ_GENERAL } from '../data/faq';
import Layout from '../layouts/Layout.astro';

const pillars = [
  { cat: 'arboristika' as const, photo: PHOTOS.vyrubNadStrechami, icon: 'tree', label: 'Záhrady, obce, stavby' },
  { cat: 'lesne-hospodarstvo' as const, photo: PHOTOS.pracaVLese, icon: 'trees', label: 'Vlastníci lesov a spoločenstvá' },
];

const benefits = [
  { icon: 'shield', title: 'Maximálna bezpečnosť', text: 'Používame certifikované stromolezecké vybavenie a postupy, pri ktorých sa nič pod stromom nepoškodí.' },
  { icon: 'umbrella', title: 'Kompletné poistenie', text: 'Pre váš úplný pokoj sme plne poistení voči prípadným škodám na majetku.' },
  { icon: 'sparkles', title: 'Čistota na prvom mieste', text: 'Po našej práci nezostáva spúšť. Konáre odvezieme alebo zoštiepkujeme, drevo napílime a priestor upraceme.' },
  { icon: 'scale', title: 'Odbornosť a legislatíva', text: 'Rozumieme stromom aj zákonom. Pomôžeme s posúdením stavu aj so súhlasom na výrub či povolením na ťažbu.' },
];

const steps = [
  { title: 'Nezáväzný kontakt', text: 'Zavoláte nám alebo vyplníte formulár. Dohodneme si termín obhliadky.' },
  { title: 'Obhliadka a ponuka zdarma', text: 'Prídeme osobne, posúdime stav stromu či porastu, navrhneme postup a pripravíme pevnú cenovú ponuku.' },
  { title: 'Bezpečná realizácia', text: 'V dohodnutom termíne prídeme a profesionálne zrealizujeme dohodnuté práce.' },
  { title: 'Upratané pracovisko', text: 'Pozemok vyčistíme a drevo pripravíme podľa vašich predstáv.' },
];

const teaser = GALLERY_TEASER.map((key) => GALLERY.find((g) => g.key === key)!).filter(Boolean);
const faq = FAQ_GENERAL.slice(0, 4);
---
<Layout
  fullTitle
  title="Stromales – orez stromov, rizikové výruby a lesné hospodárstvo"
  description="Certifikovaný arborista European Tree Worker a odborný lesný hospodár. Orezy stromov, rizikové výruby, väzby, OLH, ťažba a palivové drevo. Celé Slovensko a Česko."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="leaf-bg pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_20%_10%,black_10%,transparent_60%)]"></div>
    <div class="container-page relative grid items-center gap-12 pb-16 pt-10 sm:pt-14 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:pb-24 lg:pt-16">
      <div class="order-2 lg:order-1">
        <p class="eyebrow">Arboristika a lesné hospodárstvo</p>
        <h1 class="text-[2.6rem] leading-[1.04] sm:text-6xl lg:text-[4.25rem]">
          Odborná starostlivosť o{' '}
          <span class="relative whitespace-nowrap text-forest">
            stromy a les
            <svg class="absolute -bottom-2 left-0 h-3 w-full text-leaf" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true">
              <path d="M2 8 C 40 2, 80 2, 110 6 S 170 11, 198 4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
          </span>
        </h1>
        <p class="lead mt-7 max-w-xl">
          Orezy a rizikové výruby stromolezeckou technikou, inštalácia väzieb, odborné poradenstvo a kompletná starostlivosť o les. Bezpečne, čisto a v súlade so zákonom.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={u('/kontakt/#formular')} class="btn-primary">Obhliadka zdarma <Icon name="arrow" class="h-5 w-5" /></a>
          <a href={phoneHref(SITE.phone)} class="btn-secondary"><Icon name="phone" class="h-5 w-5" /> {SITE.phone}</a>
        </div>
        <ul class="mt-10 grid gap-3 text-[15px] font-medium text-ink sm:grid-cols-3">
          <li class="flex items-center gap-2.5"><span class="icon-tile !h-9 !w-9 !rounded-xl"><Icon name="badge" class="h-5 w-5" /></span> Certifikát ETW</li>
          <li class="flex items-center gap-2.5"><span class="icon-tile !h-9 !w-9 !rounded-xl"><Icon name="umbrella" class="h-5 w-5" /></span> Plne poistení</li>
          <li class="flex items-center gap-2.5"><span class="icon-tile !h-9 !w-9 !rounded-xl"><Icon name="globe" class="h-5 w-5" /></span> Celé SK a CZ</li>
        </ul>
      </div>

      <div class="relative order-1 lg:order-2">
        <div class="relative overflow-hidden rounded-[2.5rem] rounded-tl-[7rem] shadow-[0_30px_60px_-30px_rgb(var(--shadow)/0.45)]">
          <Image quality={72}
            src={PHOTOS.lezecVysokyStrom.src}
            alt={PHOTOS.lezecVysokyStrom.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 1024px) 100vw, 600px"
            class="aspect-[4/3] w-full object-cover sm:aspect-[5/4] lg:aspect-[4/5]"
            style={`object-position:${PHOTOS.lezecVysokyStrom.position}`}
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
        </div>
        <div class="absolute -bottom-6 left-4 flex items-center gap-3 rounded-2xl border border-line bg-surface/95 p-3 pr-5 shadow-xl backdrop-blur sm:left-6 lg:-left-8">
          <span class="grid h-14 w-14 place-items-center rounded-full bg-white p-0.5">
            <Image quality={72} src={etw} alt="Logo European Tree Worker" width={112} class="h-full w-full" />
          </span>
          <span class="leading-tight">
            <span class="block text-xs font-semibold uppercase tracking-wider text-muted">Certifikovaný</span>
            <span class="block font-serif text-lg font-semibold text-ink">European Tree Worker</span>
          </span>
        </div>
        <div class="absolute right-4 top-4 hidden items-center gap-2 rounded-full bg-surface/95 px-4 py-2 text-sm font-semibold text-ink shadow-lg backdrop-blur sm:flex">
          <span class="relative flex h-2.5 w-2.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-leaf opacity-60"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-leaf"></span></span>
          Na telefóne 24/7
        </div>
      </div>
    </div>
  </section>

  <!-- DVA PILIERE -->
  <section class="container-page mt-10 sm:mt-16" aria-labelledby="piliere-nadpis">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Čo robíme</p>
      <h2 id="piliere-nadpis" class="section-title">Od jedného stromu v záhrade po celý les</h2>
      <p class="lead mt-5">Spájame arboristiku a lesníctvo pod jednou strechou – s certifikátom European Tree Worker aj osvedčením odborného lesného hospodára.</p>
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {pillars.map((p, i) => (
        <article class="card group flex flex-col overflow-hidden !p-0" data-reveal style={`--delay:${i * 120}ms`}>
          <a href={u(CATEGORIES[p.cat].href)} class="relative block overflow-hidden" tabindex="-1" aria-hidden="true">
            <Image quality={72}
              src={p.photo.src}
              alt=""
              widths={[600, 900, 1200]}
              sizes="(max-width: 1024px) 100vw, 620px"
              class="aspect-[16/9] w-full object-cover transition duration-700 group-hover:scale-[1.04]"
              style={`object-position:${p.photo.position}`}
            />
            <span class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full bg-surface/95 px-3.5 py-1.5 text-sm font-semibold text-ink backdrop-blur">
              <Icon name={p.icon} class="h-4 w-4 text-forest" /> {p.label}
            </span>
          </a>
          <div class="flex flex-1 flex-col p-7 sm:p-9">
            <h3 class="text-3xl"><a href={u(CATEGORIES[p.cat].href)} class="hover:text-forest">{CATEGORIES[p.cat].title}</a></h3>
            <p class="mt-3 leading-relaxed">{CATEGORIES[p.cat].short}</p>
            <ul class="mt-6 grid gap-2 sm:grid-cols-2">
              {servicesIn(p.cat).map((s) => (
                <li>
                  <a href={u(serviceHref(s))} class="flex items-center gap-3 rounded-2xl border border-line px-4 py-3 font-semibold text-ink transition hover:border-forest hover:bg-moss hover:text-forest">
                    <Icon name={s.icon} class="h-5 w-5 shrink-0 text-forest" />
                    {s.title}
                  </a>
                </li>
              ))}
            </ul>
            <a href={u(CATEGORIES[p.cat].href)} class="mt-7 inline-flex items-center gap-2 font-semibold text-forest">
              {CATEGORIES[p.cat].more} <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- PREČO MY -->
  <section class="relative mt-28 overflow-hidden bg-surface-2 py-20 sm:py-24" aria-labelledby="preco-nadpis">
    <div class="rings pointer-events-none absolute inset-0"></div>
    <div class="container-page relative grid gap-12 lg:grid-cols-[1fr_1.35fr] lg:items-center">
      <div data-reveal>
        <p class="eyebrow">Prečo Stromales</p>
        <h2 id="preco-nadpis" class="section-title">Nie je to len o pílení</h2>
        <p class="lead mt-5">
          Hľadáme rovnováhu medzi bezpečnosťou ľudí a zdravím prírody. Každý zásah robíme s maximálnym ohľadom na zdravotný stav stromu aj jeho okolie.
        </p>
        <a href={u('/o-nas/')} class="btn-secondary mt-8">Kto sme <Icon name="arrow" class="h-5 w-5" /></a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {benefits.map((b, i) => (
          <div class="card" data-reveal style={`--delay:${i * 90}ms`}>
            <span class="icon-tile"><Icon name={b.icon} /></span>
            <h3 class="mt-5 text-xl">{b.title}</h3>
            <p class="mt-2 leading-relaxed">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTIFIKÁTY -->
  <section class="container-page mt-28" aria-labelledby="cert-nadpis">
    <div>
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow">Odbornosť</p>
          <h2 id="cert-nadpis" class="section-title">Certifikáty, ktoré niečo znamenajú</h2>
          <p class="lead mt-5">Za kvalitou našich služieb stoja európsky certifikát arboristu a osvedčenia z oblasti lesného hospodárstva.</p>
        </div>
        <a href={u('/o-nas/#certifikaty')} class="inline-flex shrink-0 items-center gap-2 font-semibold text-forest">Viac o certifikátoch <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {CERTIFICATES.map((c, i) => (
          <li class="card flex flex-col" data-reveal style={`--delay:${i * 100}ms`}>
            {c.id === 'etw' ? (
              <span class="grid h-16 w-16 place-items-center rounded-full bg-white p-0.5 ring-1 ring-line">
                <Image quality={72} src={etw} alt="Logo European Tree Worker" width={128} class="h-full w-full" />
              </span>
            ) : (
              <span class="icon-tile !h-16 !w-16 !rounded-full"><Icon name={c.id === 'olh' ? 'trees' : 'leaf'} class="h-7 w-7" /></span>
            )}
            <h3 class="mt-5 text-xl">{c.title}</h3>
            <p class="mt-1 text-sm font-medium text-muted">{c.issuer}</p>
            <p class="mt-3 text-[15px] leading-relaxed">{c.text}</p>
            {c.number && <p class="mt-auto pt-4 text-sm font-semibold text-forest">Číslo: {c.number}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- POSTUP -->
  <section class="container-page mt-28" aria-labelledby="postup-nadpis">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Spolupráca</p>
      <h2 id="postup-nadpis" class="section-title">Ako prebieha spolupráca</h2>
      <p class="lead mt-5">Jednoducho a prehľadne. Bezpečnosť práce a spokojnosť zákazníkov sú pre nás prioritou.</p>
    </div>
    <ol class="relative mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-transparent via-line to-transparent lg:block" aria-hidden="true"></div>
      {steps.map((s, i) => (
        <li class="relative" data-reveal style={`--delay:${i * 110}ms`}>
          <span class="relative z-10 grid h-14 w-14 place-items-center rounded-full border border-line bg-paper font-serif text-2xl font-semibold text-forest shadow-sm">{i + 1}</span>
          <h3 class="mt-5 text-xl">{s.title}</h3>
          <p class="mt-2 leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- GALÉRIA -->
  <section class="container-page mt-28" aria-labelledby="galeria-nadpis">
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end" data-reveal>
      <div>
        <p class="eyebrow">Z našej práce</p>
        <h2 id="galeria-nadpis" class="section-title">Galéria</h2>
      </div>
      <a href={u('/galeria/')} class="inline-flex items-center gap-2 font-semibold text-forest">Všetky fotky <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <Gallery items={teaser} variant="strip" />
  </section>

  <!-- O NÁS -->
  <section class="container-page mt-28" aria-labelledby="onas-nadpis">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="relative" data-reveal>
        <Image quality={72}
          src={PHOTOS.rizikovyVyrubSneh.src}
          alt={PHOTOS.rizikovyVyrubSneh.alt}
          widths={[500, 800, 1100]}
          sizes="(max-width: 1024px) 100vw, 560px"
          class="aspect-[4/3] w-full rounded-[2.5rem] rounded-br-[7rem] object-cover lg:aspect-[5/6]"
          style={`object-position:${PHOTOS.rizikovyVyrubSneh.position}`}
        />
      </div>
      <div data-reveal style="--delay:120ms">
        <p class="eyebrow">O nás</p>
        <h2 id="onas-nadpis" class="section-title">Z prechádzok v lese na Považí k celoživotnej práci</h2>
        <p class="lead mt-6">
          Láska k lesu nás priviedla na lesnícku školu na Slovensku a neskôr v Českej republike. Arboristike sa venujeme už takmer desaťročie a skúsenosti zo zahraničia využívame pri starostlivosti o stromy doma.
        </p>
        <p class="mt-4 leading-relaxed">
          Roky v štátnej správe lesného hospodárstva nás naučili lesnícku administratívu a predpisy. Dnes to všetko spájame, aby boli naše služby odborné, technicky aj legislatívne správne.
        </p>
        <a href={u('/o-nas/')} class="btn-secondary mt-8">Celý príbeh <Icon name="arrow" class="h-5 w-5" /></a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page mt-28" aria-labelledby="faq-nadpis">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.6fr]">
      <div data-reveal>
        <p class="eyebrow">Otázky</p>
        <h2 id="faq-nadpis" class="section-title">Časté otázky</h2>
        <p class="lead mt-5">Nenašli ste odpoveď? Zavolajte – sme na telefóne 24/7.</p>
        <a href={u('/cennik/')} class="mt-6 inline-flex items-center gap-2 font-semibold text-forest">Viac otázok a cenník <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div data-reveal style="--delay:100ms"><Faq items={faq} /></div>
    </div>
  </section>

  <CtaBanner />
</Layout>
