---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="divide-y divide-line overflow-hidden rounded-3xl border border-line bg-surface">
  {items.map((item) => (
    <details class="group px-6 py-5 sm:px-8 [&[open]]:bg-moss/40">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
        {item.q}
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line text-forest transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        </span>
      </summary>
      <p class="mt-3 max-w-3xl leading-relaxed">{item.a}</p>
    </details>
  ))}
</div>
