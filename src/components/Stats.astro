---
import { STATS } from '../config';
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---
<dl class:list={['grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4', cls]}>
  {STATS.map((s, i) => (
    <div class="border-t-2 border-leaf/60 pt-5" data-reveal style={`--delay:${i * 90}ms`}>
      <dt class="sr-only">{s.label}</dt>
      <dd>
        <span class="font-serif text-4xl font-semibold leading-none text-ink sm:text-5xl">{s.value}</span>
        {s.suffix && <span class="ml-1.5 font-serif text-xl font-semibold text-forest sm:text-2xl">{s.suffix}</span>}
        <span class="mt-3 block text-[15px] leading-snug text-muted">{s.label}</span>
      </dd>
    </div>
  ))}
</dl>
