---
import { abs, u } from '../config';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
const breadcrumbSchema = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ href: '/', label: 'Domov' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        item: abs(c.href),
      })),
    }
  : null;
---
<section class="relative overflow-hidden border-b border-line bg-surface-2">
  <div class="rings pointer-events-none absolute inset-0"></div>
  <div class="container-page relative py-14 sm:py-20">
    {crumbs.length > 0 && (
      <nav aria-label="Omrvinková navigácia" class="mb-6 text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={u('/')} class="hover:text-forest">Domov</a></li>
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="text-muted/50">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page" class="text-ink">{c.label}</span> : <a href={u(c.href)} class="hover:text-forest">{c.label}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="max-w-4xl text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">{title}</h1>
    {lead && <p class="lead mt-6 max-w-2xl">{lead}</p>}
    <slot />
  </div>
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
</section>
